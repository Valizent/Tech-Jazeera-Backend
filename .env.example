# ==============================================================================
# Server environment variables
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
# Every variable listed here is validated at boot by src/config/env.js —
# the server refuses to start if one is missing or malformed.
# ==============================================================================

# 'development' or 'production'. Controls log format and error verbosity.
NODE_ENV=development

# Port the API listens on.
PORT=5000

# MongoDB Atlas connection string.
# Format: mongodb+srv://<user>:<password>@<cluster-host>/<database>?retryWrites=true&w=majority
MONGODB_URI=YOUR_MONGODB_URI_HERE

# Origins allowed to call this API with credentials, comma-separated.
# Always include the web app's own origin (Vite dev server default below).
# Add https://localhost too once the Capacitor Android/iOS app shell exists —
# that's the fixed origin the native WebView serves the bundled app from
# (see client/capacitor.config.json's androidScheme).
CLIENT_URL=http://localhost:5173,https://localhost

# JWT signing secrets — two DIFFERENT random strings, at least 32 chars each,
# never reused between environments. Generate each one with:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=YOUR_ACCESS_SECRET_HERE
JWT_REFRESH_SECRET=YOUR_REFRESH_SECRET_HERE

# Where uploaded document files are stored on disk. Relative paths resolve
# against the server/ folder. The default keeps files in server/uploads/
# (gitignored). Point this at another disk or network share in production.
UPLOAD_DIR=./uploads

# Public origin the NFC tap pages (/c/<token>) are served on — goes into card
# URLs, QR codes and CSV exports. Optional: defaults to http://localhost:5000.
# For real phone taps set it to a host the phone can reach (your LAN IP, a
# tunnel URL, or your production domain). See docs/nfc-card-writing-guide.md.
PUBLIC_BASE_URL=http://localhost:5000

# Web Push (P3-F) — the app's own VAPID key pair, not a third-party secret.
# Generate with: npm run generate:vapid
# Optional: if unset, push notifications are silently disabled (the in-app
# notification list still works) rather than blocking boot — every existing
# deployment shouldn't break the moment this feature ships.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# A contact the push services (Chrome/Firefox) may reach if this server is
# ever flagged for abuse. A mailto: or https: URL.
VAPID_SUBJECT=mailto:admin@example.com

# Error tracking (self-hosted GlitchTip, Sentry-protocol-compatible) — the
# Server project's DSN. Optional: if unset, error tracking is silently
# disabled (errors still go to Winston's log files) rather than blocking
# boot, same posture as the VAPID keys above.
SENTRY_DSN=
